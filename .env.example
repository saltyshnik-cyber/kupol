# --- Telegram ---
BOT_TOKEN=            # токен от @BotFather
WEBHOOK_SECRET=       # любая длинная случайная строка (A-Z a-z 0-9 _ -)
NEXT_PUBLIC_BOT_USERNAME=   # username бота без @, например kupol_study_bot
ADMIN_IDS=            # Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_CHAT_ID=        # куда слать заявки: ID чата/группы или тот же ID админа

# --- База данных (Neon Postgres из Vercel Marketplace) ---
DATABASE_URL=

# --- Адрес задеплоенного сайта (для set-webhook) ---
SITE_URL=https://your-project.vercel.app
